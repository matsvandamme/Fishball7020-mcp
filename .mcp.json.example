{
  "mcpServers": {
    "fishball-sdr": {
      "command": "/absolute/path/to/Fishball7020-mcp/.venv/bin/python",
      "args": ["-m", "fishball_sdr_mcp"],
      "cwd": "/absolute/path/to/Fishball7020-mcp",
      "env": {
        "SDR_MCP_URI": "ip:192.168.2.1",
        "SDR_MCP_TIMEOUT": "10",
        "SDR_MCP_CAPTURE_DIR": "/tmp/fishball-captures"
      }
    }
  }
}
